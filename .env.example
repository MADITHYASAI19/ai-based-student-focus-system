# =============================================================================
# .env.example — copy to .env and fill in the values marked with <...>
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE
# Default: SQLite file (zero setup, works out of the box for local dev)
# For production with Docker: set to the Postgres URL below instead.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./study_companion.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/study_companion

# Postgres credentials (only needed when using Postgres / docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---------------------------------------------------------------------------
# REDIS (optional for local dev)
# If Redis is unreachable the app falls back to an in-process TTLCache
# automatically — no action needed. Set a real URL for production.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# CHROMADB
# CHROMA_MODE=embedded  → uses a local PersistentClient (./chroma_data dir)
#                         No Docker container required. Recommended for dev.
# CHROMA_MODE=http      → connects to a running ChromaDB HTTP server.
#                         Set CHROMA_URL to the server address.
# ---------------------------------------------------------------------------
CHROMA_MODE=embedded
CHROMA_URL=http://localhost:8001

# ---------------------------------------------------------------------------
# SECURITY — change this to a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=<change-this-to-a-long-random-secret>

# ---------------------------------------------------------------------------
# AI SERVICES
# AI_API_KEY   — Groq API key used by the LLM for quiz generation and doubts.
#                Get one at: https://console.groq.com/
# LLM_MODEL_NAME — Model served via the OpenAI-compatible endpoint.
#                  Default works with Groq; change for other providers.
# OPENAI_API_KEY — Only needed if you run the embedding pipeline
#                  (ai_service/embeddings). Not required for basic operation.
# ---------------------------------------------------------------------------
AI_API_KEY=<your-groq-api-key>
LLM_MODEL_NAME=openai/gpt-oss-120b
# OPENAI_API_KEY=<your-openai-api-key>

# ---------------------------------------------------------------------------
# FRONTEND
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
